; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes to "section" property, again, non-existent means engine.cfg-like behavior
;
; All of the following can be set from the editor UI, this file is generated
; automatically and shouldn't need to be edited manually.

config_version=5

[application]

config/name="Koop-Kolonie-Survival"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[rendering]

renderer/rendering_method="gl_compatibility"
